{
  "name": "eventflow",
  "version": "1.0.0",
  "description": "A reliable, offset-based event streaming backend with idempotent publishing, durable consumer checkpoints, and dead-letter queue recovery.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "consumer": "node Consumer/consumer.js",
    "test": "node --test tests/unit/backoff.test.js tests/unit/auth.test.js tests/unit/schemas.test.js tests/integration/api.test.js",
    "perf": "node scripts/benchmark.js",
    "perf:k6": "k6 run scripts/k6_load_test.js",
    "perf:smoke": "k6 run --vus 5 --duration 10s scripts/k6_load_test.js"
  },
  "keywords": ["event-streaming", "event-driven", "nodejs", "mongodb", "redis"],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.14.0",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "mongoose": "^9.3.3",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
