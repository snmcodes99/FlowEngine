# === EventFlow Environment Configuration ===

# Server
PORT=3000
NODE_ENV=development

# MongoDB (must be a replica set for transaction support)
MONGO_URI=mongodb://localhost:27017/eventflow?replicaSet=rs0

# Redis (used for caching and pub/sub notifications, NOT for offset allocation)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# API Security
API_KEY=your-api-key-here

# Publishing
MAX_PAYLOAD_SIZE_KB=1024
DEFAULT_MAX_RETRY_ATTEMPTS=3

# Consumer
CONSUMER_POLL_INTERVAL_MS=2000
CONSUMER_BATCH_SIZE=100
